# ShareDocu frontend — ví dụ cấu hình biến môi trường
#
# Native (Android/iOS): copy file này thành ".env" (dùng nguyên trạng)
# Web (webpack):        copy thành ".env.web", comment dòng API_URL của native,
#                       rồi uncomment phần Web phía dưới
#
# Đọc bởi src/config/env.ts (chỉ dùng API_URL; không set sẽ dùng default theo platform)

# ==== Native (.env) ====
# Android emulator:  http://10.0.2.2:5000/api
# iOS simulator:     http://localhost:5000/api
# Thiết bị thật:     IP LAN của máy, ví dụ http://192.168.1.10:5000/api
API_URL=http://10.0.2.2:5000/api

# ==== Web (.env.web) — uncomment khi dùng file cho web ====
# API_URL=http://localhost:5000/api
# PLATFORM=web
